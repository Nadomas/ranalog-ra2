:root {
    --bg: #0e1116;
    --panel: #151a22;
    --panel-2: #1b222d;
    --edge: #2a3340;
    --edge-soft: #3a4656;
    --text: #eef2f6;
    --muted: #8b97a8;
    --accent: #f0a84a;
    --accent-dim: #b87828;
    --accent-ink: #1a1208;
    --danger: #d4573a;
    --ok: #3d9b6e;
    --ok-dim: #2a6b4c;
    --font: "Segoe UI";
}

.root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
    font-size: 13px;
    -unity-font: var(--font);
}

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(14, 17, 22, 0.94);
    border-bottom-width: 1px;
    border-bottom-color: var(--edge);
}

.brand-block {
    flex-direction: row;
    align-items: flex-end;
    margin-right: 20px;
}

.brand {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--accent);
    letter-spacing: 3px;
    margin-right: 6px;
}

.brand-sub {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 3px;
    margin-bottom: 3px;
}

.flow {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    background-color: rgba(27, 34, 45, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--edge);
}

.flow-step {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
    padding: 2px 4px;
}

.flow-step.active {
    color: var(--accent);
    -unity-font-style: bold;
}

.flow-step.done {
    color: var(--ok);
}

.flow-sep {
    color: var(--edge-soft);
    margin-left: 4px;
    margin-right: 4px;
    font-size: 12px;
}

.spacer {
    flex-grow: 1;
}

.mode-pill {
    background-color: var(--accent);
    color: var(--accent-ink);
    padding: 5px 12px;
    border-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 8px;
}

.admit-badge {
    padding: 5px 10px;
    border-radius: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-color: #2a3340;
    color: var(--muted);
    border-width: 1px;
    border-color: var(--edge);
}

.admit-badge.ready {
    background-color: var(--ok-dim);
    color: #d8ffe8;
    border-color: var(--ok);
}

.body {
    flex-grow: 1;
    flex-direction: row;
}

.side-panel {
    width: 340px;
    background-color: rgba(21, 26, 34, 0.96);
    border-right-width: 1px;
    border-right-color: var(--edge);
    padding: 14px 14px 10px 14px;
}

.section-title {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 2px;
    margin-bottom: 8px;
    margin-top: 2px;
}

.mode-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.mode-btn {
    flex-grow: 1;
    height: 38px;
    margin-right: 6px;
    background-color: var(--panel-2);
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
    color: var(--text);
    font-size: 12px;
}

.mode-btn.mode-btn-end {
    margin-right: 0;
}

.mode-btn:hover {
    border-color: var(--edge-soft);
    background-color: #242c38;
}

.mode-btn.active {
    background-color: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
    -unity-font-style: bold;
}

.tool-panel {
    margin-bottom: 10px;
    padding: 12px;
    background-color: #11161d;
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 5px;
}

.tool-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: var(--text);
}

.tool-help {
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 8px;
    white-space: normal;
}

.tool-meta {
    color: var(--accent);
    font-size: 12px;
    margin-bottom: 10px;
    white-space: normal;
    -unity-font-style: bold;
}

.key-chips {
    flex-direction: row;
    margin-bottom: 10px;
}

.chip {
    background-color: #242b36;
    color: var(--text);
    padding: 4px 8px;
    border-radius: 3px;
    margin-right: 6px;
    font-size: 11px;
    border-width: 1px;
    border-color: var(--edge);
}

.row {
    flex-direction: row;
}

.tool-btn {
    flex-grow: 1;
    height: 34px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: #2a3340;
    border-width: 1px;
    border-color: var(--edge-soft);
    border-radius: 4px;
    color: var(--text);
    font-size: 12px;
}

.tool-btn.tool-btn-end {
    margin-right: 0;
}

.tool-btn.wide {
    margin-right: 0;
    width: 100%;
}

.tool-btn.accent {
    background-color: var(--accent-dim);
    border-color: var(--accent);
    color: var(--accent-ink);
    -unity-font-style: bold;
}

.tool-btn.fight {
    background-color: var(--danger);
    border-color: #f07858;
    color: #fff;
    -unity-font-style: bold;
    height: 44px;
    margin-top: 2px;
    font-size: 13px;
    letter-spacing: 0.5px;
}

.tool-btn:hover {
    background-color: #364152;
}

.tool-btn.accent:hover {
    background-color: var(--accent);
}

.tool-btn.fight:hover {
    background-color: #e86a4c;
}

.tool-btn:disabled {
    opacity: 0.35;
}

.divider {
    height: 1px;
    background-color: var(--edge);
    margin-top: 6px;
    margin-bottom: 12px;
}

.status-box {
    margin-top: 10px;
    padding: 10px;
    background-color: #0c1016;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--edge);
    flex-grow: 1;
    min-height: 72px;
}

.status-caption {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.status {
    color: var(--text);
    font-size: 12px;
    white-space: normal;
    min-height: 40px;
}

.arena-chrome {
    flex-grow: 1;
    padding: 12px 14px;
}

.arena-top {
    flex-direction: row;
    align-items: center;
}

.arena-caption {
    background-color: rgba(14, 17, 22, 0.78);
    color: var(--muted);
    padding: 7px 12px;
    border-radius: 3px;
    font-size: 11px;
    letter-spacing: 1.5px;
    border-width: 1px;
    border-color: var(--edge);
}

.wire-canvas {
    margin-top: 8px;
    max-height: 240px;
    background-color: #0c1016;
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
    padding: 4px;
}

.control-grid {
    flex-direction: column;
    margin-bottom: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--edge);
}

.control-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 6px;
    background-color: #121820;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--edge);
}

.control-row-name {
    flex-grow: 1;
    font-size: 11px;
    color: var(--text);
    white-space: normal;
}

.grid-section {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 1px;
    margin: 4px 2px 6px 2px;
}

.wire-group {
    font-size: 11px;
    color: var(--accent);
    margin: 6px 2px 2px 2px;
    -unity-font-style: bold;
}

.wire-conflicts {
    margin-top: 4px;
    color: var(--muted);
}

.wire-list {
    flex-direction: column;
}

.wire-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 6px;
    background-color: #151a22;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--edge);
}

.wire-row-label {
    flex-grow: 1;
    font-size: 11px;
    color: var(--text);
    white-space: normal;
}

.wire-mini {
    height: 26px;
    min-width: 44px;
    margin-left: 4px;
    margin-right: 0;
    margin-bottom: 0;
    font-size: 10px;
    padding-left: 4px;
    padding-right: 4px;
}

.lan-box {
    margin-top: 8px;
    padding: 8px;
    background-color: #11161d;
    border-width: 1px;
    border-color: var(--edge);
    border-radius: 4px;
}

.lan-field {
    margin-bottom: 6px;
    height: 28px;
}

.fight-pill {
    margin-left: 8px;
    background-color: var(--danger);
    color: #fff;
    padding: 7px 12px;
    border-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.fight-hud {
    margin-top: 10px;
    flex-direction: row;
    align-items: center;
    align-self: center;
    padding: 8px 16px;
    background-color: rgba(14, 17, 22, 0.82);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--edge);
    min-width: 280px;
}

.fight-side {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-grow: 1;
}

.fight-side.you {
    color: #6eb6ff;
    -unity-text-align: middle-left;
}

.fight-side.ai {
    color: #ff8a6b;
    -unity-text-align: middle-right;
}

.fight-timer {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-left: 16px;
    margin-right: 16px;
    min-width: 64px;
    -unity-text-align: middle-center;
}

.spacer-v {
    flex-grow: 1;
}

.bottom-bar {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    background-color: rgba(14, 17, 22, 0.88);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--edge);
}

.help-line {
    flex-grow: 1;
    color: var(--text);
    font-size: 12px;
    white-space: normal;
}

.build-tag {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
    margin-left: 12px;
}

.hidden {
    display: none;
}

.results-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(6, 8, 12, 0.78);
    justify-content: center;
    align-items: center;
}

.results-card {
    width: 460px;
    padding: 28px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--accent-dim);
    border-radius: 8px;
    border-top-width: 3px;
    border-top-color: var(--accent);
}

.results-kicker {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.results-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-bottom: 12px;
}

.results-rule {
    height: 1px;
    background-color: var(--edge);
    margin-bottom: 14px;
}

.results-body {
    color: var(--text);
    white-space: normal;
    margin-bottom: 20px;
    min-height: 110px;
    font-size: 13px;
}

.history-btn {
    margin-left: 10px;
    min-width: 72px;
    height: 28px;
    padding: 2px 10px;
    font-size: 11px;
}

.history-card {
    width: 520px;
    max-height: 86%;
}

.history-list {
    height: 180px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--edge);
    padding: 4px;
}

.history-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 2px;
    background-color: rgba(255, 255, 255, 0.03);
}

.history-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.history-row-label {
    flex-grow: 1;
    font-size: 12px;
    color: var(--text);
    white-space: normal;
}

.history-detail {
    min-height: 90px;
    margin-bottom: 12px;
    font-size: 12px;
}
