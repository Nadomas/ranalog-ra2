<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MvpWorkshop.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement class="brand-block">
                <ui:Label name="brand" text="RA2" class="brand" />
                <ui:Label text="ANALOG" class="brand-sub" />
            </ui:VisualElement>
            <ui:VisualElement name="flow" class="flow">
                <ui:Label name="step-design" text="1 DESIGN" class="flow-step" />
                <ui:Label text="›" class="flow-sep" />
                <ui:Label name="step-configure" text="2 CONFIGURE" class="flow-step" />
                <ui:Label text="›" class="flow-sep" />
                <ui:Label name="step-test" text="3 TEST" class="flow-step" />
                <ui:Label text="›" class="flow-sep" />
                <ui:Label name="step-fight" text="4 FIGHT" class="flow-step" />
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:Label name="mode-label" text="DESIGN" class="mode-pill" />
            <ui:Label name="admit-badge" text="NO ADMIT" class="admit-badge" />
            <ui:Button name="btn-history" text="History" class="tool-btn history-btn" />
        </ui:VisualElement>

        <ui:VisualElement name="body" class="body">
            <ui:VisualElement name="side-panel" class="side-panel">
                <ui:Label text="BUILD / WIRE / DRIVE" class="section-title" />
                <ui:VisualElement class="mode-row">
                    <ui:Button name="btn-design" text="Design" class="mode-btn" />
                    <ui:Button name="btn-configure" text="Wire" class="mode-btn" />
                    <ui:Button name="btn-test" text="Drive" class="mode-btn mode-btn-end" />
                </ui:VisualElement>

                <ui:VisualElement name="panel-design" class="tool-panel">
                    <ui:Label text="Chassis polygon" class="tool-title" />
                    <ui:Label text="Select a vertex, then nudge to reshape the chassis outline." class="tool-help" />
                    <ui:Label name="poly-info" text="pts=0" class="tool-meta" />
                    <ui:VisualElement class="row">
                        <ui:Button name="btn-poly-prev" text="◀ Prev" class="tool-btn" />
                        <ui:Button name="btn-poly-next" text="Next ▶" class="tool-btn tool-btn-end" />
                    </ui:VisualElement>
                    <ui:Button name="btn-poly-nudge" text="Nudge +X" class="tool-btn wide accent" />
                </ui:VisualElement>

                <ui:VisualElement name="panel-configure" class="tool-panel hidden">
                    <ui:Label text="Wiring canvas" class="tool-title" />
                    <ui:Label text="Rows = slot → part. Click Sign / Channel to edit. TankSteer resets map." class="tool-help" />
                    <ui:Label name="bind-info" text="Drive=—  Turn=—" class="tool-meta" />
                    <ui:VisualElement class="row">
                        <ui:Button name="btn-bind-drive" text="Drive" class="tool-btn" />
                        <ui:Button name="btn-bind-turn" text="Turn" class="tool-btn tool-btn-end" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Button name="btn-bind-cycle" text="Cycle binding" class="tool-btn" />
                        <ui:Button name="btn-tank" text="TankSteer" class="tool-btn accent tool-btn-end" />
                    </ui:VisualElement>
                    <ui:ScrollView name="wire-canvas" class="wire-canvas">
                        <ui:VisualElement name="wire-list" class="wire-list" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:VisualElement name="panel-test" class="tool-panel hidden">
                    <ui:Label text="Test Room" class="tool-title" />
                    <ui:Label text="Drive the assembled bot on the floor before admitting to a fight." class="tool-help" />
                    <ui:VisualElement class="key-chips">
                        <ui:Label text="W A S D" class="chip" />
                        <ui:Label text="SPACE brake" class="chip" />
                    </ui:VisualElement>
                    <ui:Button name="btn-reset" text="Reset Test Spawn" class="tool-btn wide accent" />
                </ui:VisualElement>

                <ui:VisualElement class="divider" />
                <ui:Label text="FIGHT" class="section-title" />
                <ui:Label text="Local / UDP loopback / LAN host-join (2 processes)." class="tool-help" />
                <ui:Button name="btn-admit" text="Prepare Admit" class="tool-btn wide" />
                <ui:Button name="btn-admit-test" text="Test Admit Clone" class="tool-btn wide" />
                <ui:Button name="btn-fight" text="Start Local Fight" class="tool-btn wide fight" />
                <ui:Button name="btn-udp-fight" text="UDP Loopback Fight" class="tool-btn wide accent" />
                <ui:VisualElement class="lan-box">
                    <ui:Label text="LAN" class="status-caption" />
                    <ui:TextField name="lan-host-field" value="127.0.0.1" class="lan-field" />
                    <ui:VisualElement class="row">
                        <ui:Button name="btn-lan-host" text="Host LAN" class="tool-btn" />
                        <ui:Button name="btn-lan-join" text="Join LAN" class="tool-btn accent tool-btn-end" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="status-box" class="status-box">
                    <ui:Label text="STATUS" class="status-caption" />
                    <ui:Label name="status" text="Ready" class="status" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="arena-chrome" class="arena-chrome">
                <ui:VisualElement class="arena-top">
                    <ui:Label name="arena-caption" text="TEST ROOM · WASD" class="arena-caption" />
                    <ui:Label name="fight-pill" text="" class="fight-pill hidden" />
                </ui:VisualElement>

                <ui:VisualElement name="fight-hud" class="fight-hud hidden">
                    <ui:Label name="fight-you" text="YOU" class="fight-side you" />
                    <ui:Label name="fight-timer" text="0:00" class="fight-timer" />
                    <ui:Label name="fight-ai" text="AI" class="fight-side ai" />
                </ui:VisualElement>

                <ui:VisualElement class="spacer-v" />
                <ui:VisualElement name="bottom-bar" class="bottom-bar">
                    <ui:Label name="help-line" text="WASD to drive · Local Fight when ready." class="help-line" />
                    <ui:Label name="build-tag" text="MVP · LOCAL" class="build-tag" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="results-overlay" class="results-overlay hidden">
            <ui:VisualElement class="results-card">
                <ui:Label text="MATCH RESULTS" class="results-kicker" />
                <ui:Label name="results-title" text="Fight complete" class="results-title" />
                <ui:VisualElement class="results-rule" />
                <ui:Label name="results-body" text="" class="results-body" />
                <ui:Button name="btn-results-close" text="Back to Workshop" class="tool-btn wide accent" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="history-overlay" class="results-overlay hidden">
            <ui:VisualElement class="results-card history-card">
                <ui:Label text="MATCH HISTORY" class="results-kicker" />
                <ui:Label text="Local saved fights" class="results-title" />
                <ui:Label text="Newest first · from this machine only." class="tool-help" />
                <ui:VisualElement class="results-rule" />
                <ui:ScrollView name="history-list" class="history-list" />
                <ui:Label name="history-detail" text="" class="results-body history-detail" />
                <ui:Button name="btn-history-close" text="Close" class="tool-btn wide accent" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
